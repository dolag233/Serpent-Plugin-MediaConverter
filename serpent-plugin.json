{
  "manifestVersion": 1,
  "id": "com.dolag.serpent.media-converter",
  "version": "0.1.0",
  "name": "Media Converter",
  "description": "Batch video conversion and image/video compression using the host FFmpeg.",
  "author": "Dolag",
  "license": "MIT",
  "repository": "https://github.com/dolag233/Serpent-Plugin-MediaConverter",
  "engines": {
    "serpent": ">=0.1.0 <1.0.0",
    "pluginApi": 1
  },
  "runtime": {
    "mode": "unrestricted",
    "entry": "entry/main.js",
    "instanceScope": "global"
  },
  "permissions": [
    "asset.read",
    "content.read",
    "content.write",
    "data.files",
    "file.import",
    "file.rename",
    "job.manage",
    "library.read",
    "metadata.read",
    "metadata.write",
    "storage.read",
    "storage.write",
    "tag.read",
    "tag.write",
    "ui.notify",
    "ui.dialogs",
    "media.binaries"
  ],
  "contributes": {
    "commands": [
        {
          "id": "mediaconverter.open-convert",
          "title": "视频转码",
        "when": "selection.assetCount == selection.count && selection.assetCount != 0 && selection.extensions intersects ['mp4','mov','mkv','webm','avi','m4v','ts','mts','m2ts']",
        "enablement": "library.writable && selection.hasDeleted == false && selection.hasUnavailable == false"
      },
        {
          "id": "mediaconverter.open-compress",
          "title": "压缩体积",
        "when": "selection.assetCount == selection.count && selection.assetCount != 0 && (selection.extensions intersects ['mp4','mov','mkv','webm','avi','m4v','ts','mts','m2ts'] || selection.extensions intersects ['jpg','jpeg','png','webp','bmp','tif','tiff','gif','avif'])",
        "enablement": "library.writable && selection.hasDeleted == false && selection.hasUnavailable == false"
      }
    ],
    "menus": {
      "asset": [
        {
          "title": "视频转码",
          "command": "mediaconverter.open-convert",
          "group": "media-tools",
          "when": "selection.assetCount == selection.count && selection.assetCount != 0 && selection.extensions intersects ['mp4','mov','mkv','webm','avi','m4v','ts','mts','m2ts']",
          "enablement": "library.writable && selection.hasDeleted == false && selection.hasUnavailable == false"
        },
        {
          "title": "压缩体积",
          "command": "mediaconverter.open-compress",
          "group": "media-tools",
          "when": "selection.assetCount == selection.count && selection.assetCount != 0 && (selection.extensions intersects ['mp4','mov','mkv','webm','avi','m4v','ts','mts','m2ts'] || selection.extensions intersects ['jpg','jpeg','png','webp','bmp','tif','tiff','gif','avif'])",
          "enablement": "library.writable && selection.hasDeleted == false && selection.hasUnavailable == false"
        }
      ]
    },
    "toolbar": [],
    "inspector": [],
    "viewerActions": [],
    "shortcuts": [],
    "views": [],
    "settings": [],
    "hooks": [],
    "jobs": [
      {
        "id": "media-convert",
        "title": "媒体转换 / 压缩",
        "recovery": "idempotent"
      }
    ],
    "providers": [],
    "themes": [],
    "dialogs": []
  }
}
